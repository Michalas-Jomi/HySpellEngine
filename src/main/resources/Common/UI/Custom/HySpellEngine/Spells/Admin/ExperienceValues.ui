$C = "../../../Common.ui";

$C.@Container {
  Anchor: (Width: 400 + 34, Height: 800 + 38 + 34, Left: 10);

  #Title {
    $C.@TitleLabel {
      Text: "Values";
    }
  }

 #Content { Group #ExperienceValuesRoot {
  Anchor: (Width: 400, Height: 800, Left: 0);
  FlexWeight: 1;
  LayoutMode: TopScrolling;
  ScrollbarStyle: $C.@DefaultScrollbarStyle;

  Group #TitleGroup {
    LayoutMode: Top;
    Label #Description {
      Style: (
        FontSize: 16,
        TextColor: #ffffff
      );
    }
  }
  Group #Values {
    LayoutMode: Top;
    Anchor: (Left: 10);
  }
  Group #ButtonGroup {
    LayoutMode: Center;
    Padding: (Horizontal: 10);
    TextButton #AddButton {
      Style: $C.@DefaultTextButtonStyle;
      Text: "Add";
      Anchor: (Height: 30, Width: 380, Top: 10);
    }
  }
}}}
