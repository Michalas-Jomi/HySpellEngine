$C = "../../../Common.ui";

Group #ExperienceValuesRoot {
  Anchor: (Width: 400, Height: 800, Left: 10);
  Background: #FF9966;
  FlexWeight: 1;
  LayoutMode: TopScrolling;
  ScrollbarStyle: $C.@DefaultScrollbarStyle;

  Group #TitleGroup {
    LayoutMode: Top;
    Label #Title {
      Anchor: (Height: 32);
      Text: "Values";
      Style: (
        FontSize: 18,
        TextColor: #ffffff,
        RenderBold: true,
        HorizontalAlignment: Center
      );
    }
    Label #Description {
      Style: (
        FontSize: 16,
        TextColor: #ffffff
      );
    }
  }
  Group #Values {
    LayoutMode: Top;
  }
  Group #ButtonGroup {
    LayoutMode: Center;
    TextButton #AddButton {
      Style: $C.@DefaultTextButtonStyle;
      Text: "Add";
      Anchor: (Height: 30, Width: 400);
    }
  }
}
